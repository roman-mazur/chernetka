Changing CUE configuration: internal/ci/go.cue in commit 8d694ff.

-- before.cue --
package ci

import "cue.dev/x/githubactions"

// goVersion is the Go release the workflows build with, matching go.mod.
goVersion: "1.27"

// #goSetup checks out the repository and installs Go: the first steps of the jobs building the code.
#goSetup: [...githubactions.#Step] & [
	{
		name: "Checkout code"
		uses: "actions/checkout@v7"
	},
	{
		name: "Set up Go"
		uses: "actions/setup-go@v7"
		with: "go-version": goVersion
	},
]
-- after.cue --
package ci

import "cue.dev/x/githubactions"

// #goSetup checks out the repository and installs Go, in the version go.mod declares: the first
// steps of the jobs building the code.
#goSetup: [...githubactions.#Step] & [
	{
		name: "Checkout code"
		uses: "actions/checkout@v7"
	},
	{
		name: "Set up Go"
		uses: "actions/setup-go@v7"
		with: "go-version-file": "go.mod"
	},
]
